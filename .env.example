# Copiar como .env. Los cambios en variables VITE_* requieren reiniciar `npm run dev` o recompilar.

# false = consumir el API Gateway real. true = datos simulados en localStorage/IndexedDB (sin backend).
VITE_USE_MOCK=false

# URL publica del Gateway terminada en /api/v1 (sin barra final).
# Local: http://localhost:8080/api/v1 · Despliegue: la URL HTTPS que entregue infraestructura.
# El origen de este frontend (ej. http://localhost:5173) debe estar en CORS_ORIGINS del Gateway.
# Alternativa en desarrollo sin tocar CORS: VITE_API_URL=/api/v1 (vite.config.js lo reenvia a localhost:8080).
VITE_API_URL=https://depilugfz8.execute-api.us-east-1.amazonaws.com/api/v1


# Rutas de Job Search y Gap Analysis (relativas a VITE_API_URL).
VITE_JOB_SEARCH_PATH=/jobs
VITE_JOB_DETAIL_PATH=/jobs/:id
VITE_GAP_ANALYSIS_PATH=/gap-reports
